# Inkling — local configuration. Copy to .env.local (gitignored) and fill in what you have.
# Everything works without keys: AI features show a quiet "needs an API key" note, Read aloud uses
# the browser's voice. Adding a key takes effect on the next request (restart `next dev` if the
# change isn't picked up).

# ── AI re-teach (help cards, check questions, revision reading, concept labels) ──────────────
# Which provider: openai | groq | gemini | grok | fake. Unset = auto-detect by available key
# (OPENAI_API_KEY, then GROQ_API_KEY, then GEMINI_API_KEY, then XAI_API_KEY). "fake" is deterministic
# and offline (tests).
AI_PROVIDER=

# OpenAI (also enables Whisper auto-transcription and OpenAI text-to-speech).
OPENAI_API_KEY=
# Vision-capable chat model with structured outputs. Default: gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
# For reasoning models (gpt-5*, o*): minimal | low | medium | high. Default: minimal (fast, cheap).
# OPENAI_REASONING_EFFORT=minimal
# OPENAI_BASE_URL=https://api.openai.com/v1

# Groq — GroqCloud, keys start with gsk_ (console.groq.com/keys). NOT xAI's Grok (xai-… keys, below).
# OpenAI-compatible endpoint. Also enables Whisper auto-transcription when OPENAI_API_KEY is unset
# (whisper-large-v3-turbo, word timestamps, files up to 25 MB). Groq has no read-aloud voice here.
GROQ_API_KEY=
# Text model (help cards, labels). Default: openai/gpt-oss-120b (strict JSON-schema outputs).
# Models without strict schemas (e.g. llama-3.1-8b-instant) use JSON mode + validation instead.
# GROQ_MODEL=openai/gpt-oss-120b
# Vision model for reading handwriting revisions. Default: qwen/qwen3.8-27b (Groq preview model).
# "none" turns Groq vision off: revisions are then read by the next provider with a key, if any.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GPT-OSS: low | medium | high (default low). Qwen 3.x: none | default | low | medium | high.
# GROQ_REASONING_EFFORT=low
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini (OpenAI-compatible endpoint). Default model: gemini-3.1-flash-lite.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# xAI Grok — keys start with xai- (not Groq's gsk_). OpenAI-compatible endpoint.
# Default model: grok-4-fast-non-reasoning.
XAI_API_KEY=
# XAI_MODEL=grok-4-fast-non-reasoning
# XAI_BASE_URL=https://api.x.ai/v1

# ── Read aloud (text to speech) ──────────────────────────────────────────────────────────────
# ElevenLabs if set, else OpenAI TTS (OPENAI_API_KEY), else the browser's speechSynthesis.
ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs voice library. Default: 21m00Tcm4TlvDq8ikWAM ("Rachel").
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# ── Demo / cost controls ─────────────────────────────────────────────────────────────────────
# 1 = serve only cached results and the bundled fixtures (public/demo/ai-cache.json) for the demo
# lecture; never calls the network (other lectures get the offline fake provider).
DEMO_MODE=
# 1 = after an analysis, prepare help for the top 3 moments in the background (off by default).
# AI_PREFETCH=
# Fresh AI generations per session per 10 minutes (cached results are free). Default 30.
# AI_RATE_LIMIT=30
# Provider calls in flight at once. Default 2.
# AI_MAX_CONCURRENCY=2

# ── Storage ──────────────────────────────────────────────────────────────────────────────────
# Unset = local SQLite file (data/inkling.db, or INKLING_DB_PATH). Set to a Postgres URL to store
# everything in Postgres instead — e.g. a free Tiger Data (Timescale Cloud) service, which also
# turns on the TimescaleDB features (ink_samples hypertable, time_bucket window stats, continuous
# aggregate for class-wide hotspots). Tables are created/migrated on first use. Restart after
# changing. GET /api/health shows { backend, timescale }. The URL is never logged.
#   (no sslmode)         encrypted for any remote host (certificate not verified); plaintext only
#                        for this machine (localhost, 127.0.0.0/8, ::1, unix sockets)
#   sslmode=require      encrypted (libpq semantics: certificate not verified)
#   sslmode=verify-full  encrypted and certificate verified
#   sslmode=disable      plaintext, even to a remote host (only for a trusted network)
# DATABASE_URL=postgres://tsdbadmin:YOUR_PASSWORD@YOUR_SERVICE.YOUR_PROJECT.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=
# Postgres connections kept in the pool. Default 5.
# PG_POOL_MAX=5

# ── Marketing page (/welcome) ────────────────────────────────────────────────────────────────
# The "Ask Inkling" assistant (POST /api/ask) uses GROQ_API_KEY above; without it (or with
# LANDING_AI_DISABLED=1) it answers from the built-in FAQ ("offline answer").
# Model for the assistant (Groq OpenAI-compatible chat API). Default openai/gpt-oss-20b.
# LANDING_AI_MODEL=openai/gpt-oss-20b
# Max assistant model calls per day per server instance (over it: offline answers). Default 500.
# LANDING_AI_DAILY_CAP=500
# 1 = the assistant never calls the model.
# LANDING_AI_DISABLED=
# Where "Open Inkling" points (default /app, this site).
# NEXT_PUBLIC_APP_URL=
# Absolute site URL for og:image etc. (Vercel's production URL is used automatically).
# NEXT_PUBLIC_SITE_URL=
