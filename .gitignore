# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# extra build dirs of side-by-side dev/e2e/preview servers (INKLING_DIST_DIR)
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the documented template (no secrets in it).
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (SQLite)
/data

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# design screenshots
/screenshots

# Old standalone marketing site; merged into app/(marketing)
/landing/
